<div class="research-listing">
<% for (let i = 0; i < items.length; i++) { %>
<% const item = items[i]; %>
<div class="research-item <%= i % 2 !== 0 ? 'reverse' : '' %>">
<div class="research-content">
<div class="research-title"><a href="<%= item.path %>"><%= item.title %></a></div>
<% if (item.categories && item.categories.length) { %><div class="research-tags"><% item.categories.forEach(cat => { %><span class="tag"><%= cat %></span><% }) %></div><% } %>
<% if (item.description) { %><div class="research-description"><%= item.description %></div><% } %>
<a class="research-link" href="<%= item.path %>">View Project →</a>
</div>
<% if (item.image) { %><div class="research-image"><img src="<%= item.image %>" alt="<%= item['image-alt'] || item.title %>" loading="lazy" /></div><% } %>
</div>
<% } %>
</div>
